# 릴리즈 서명 설정 예시.
# 1) 키스토어 생성 (프로젝트 루트가 아닌 안전한 위치 권장):
#    keytool -genkey -v -keystore %USERPROFILE%\cubed-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2) 이 파일을 key.properties 로 복사해 실제 값을 채우세요. (key.properties는 .gitignore에 포함됨)
storePassword=키스토어_비밀번호
keyPassword=키_비밀번호
keyAlias=upload
storeFile=C:/Users/hongb/cubed-upload-key.jks
